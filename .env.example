# Copy to .env and fill in for local development.

# The multiplayer server (see server/). Expo Go on a physical device can't
# resolve "localhost" to your dev machine -- use your LAN IP there instead,
# e.g. http://192.168.1.23:4000. Day-to-day this should point at your LOCAL
# server (server/'s `npm run dev`, itself pointed at your local Postgres --
# see server/README.md), not the deployed Railway one, so ordinary
# development never touches production. Swap in the public wss:// URL only
# to deliberately smoke-test against production once a change has shipped.
EXPO_PUBLIC_SERVER_URL=http://localhost:4000

# Production (Railway, see README.md's "Redeploying the server to Railway"):
# EXPO_PUBLIC_SERVER_URL=https://server-production-62b1.up.railway.app

# AdMob ad unit IDs (see src/lib/ads/adsConfig.ts). Leave UNSET to use Google's
# public TEST ad units (the default, and what every build uses until the real
# AdMob account exists). The real *app* ID goes in app.json's
# react-native-google-mobile-ads plugin entry, not here. Never ship a Play
# Store build with test units, and never tap your own real ads.
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy

# Sentry crash reporting (src/lib/crashReporting.ts). Leave the DSN UNSET to disable it entirely
# (the default in development). The DSN is public by design -- it ships inside the APK. The
# build-time secret (SENTRY_AUTH_TOKEN, for source-map upload) does NOT go here: see .env.sentry.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# Fraction of sessions that also send performance timings (default 0.1; 0 = errors/crashes only).
# EXPO_PUBLIC_SENTRY_TRACES=0.1
