# Local dev DB (see server/README.md's "Local development vs. production"
# for the one-time `CREATE ROLE`/`CREATE DATABASE` setup). Never point this
# .env at the real Neon database -- that lives in a separate,
# never-committed server/.env.production, used only by the `:remote` npm
# scripts to deliberately push a tested change to production.
DATABASE_URL=postgres://rockstyle_dev:password@127.0.0.1:5432/rockstyle_chess_dev
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Should match how clients reach this server (EXPO_PUBLIC_SERVER_URL in the
# app's own .env) -- used to build correct callback/redirect URLs.
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated web origins allowed to call the API/Socket.IO with cookies
# (browsers only -- the native Expo app doesn't send an Origin header).
WEB_CLIENT_ORIGINS=http://localhost:8081
# Must match app.json's "scheme" -- used to validate OAuth/deep-link redirects.
MOBILE_APP_SCHEME=rockstylechess
# Real-money IAP verification (googlePlay.ts, POST /me/purchases/verify).
# ANDROID_PACKAGE_NAME must match app.json's android.package exactly.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is the full JSON key contents (one line)
# for a Google Cloud service account linked in Play Console -> Setup -> API
# access, granted view access to "Financial data, orders, and cancellation
# survey responses" for this app -- see the IAP plan for the one-time setup.
# Leave both unset in local dev if you're not testing purchases; routes that
# need them throw a clear error instead of silently misbehaving.
ANDROID_PACKAGE_NAME=com.rockstylechess.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Push notifications (push.ts, pushScheduler.ts) via the Expo Push Service. Nothing is required: with no
# devices registered nothing is sent. EXPO_ACCESS_TOKEN is only needed if "Enhanced push security" is on for
# the Expo project (expo.dev -> Project -> Credentials). EXPO_PUSH_DISABLED=1 turns sending off entirely
# (local dev). The FCM service-account key is uploaded to Expo, NOT to this server.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_DISABLED=

# "Continue with Google" (betterAuth.ts). Create a *Web application* OAuth client in Google Cloud Console and add
# the redirect URI  <BETTER_AUTH_URL>/api/auth/callback/google . Leave both unset to switch Google sign-in off
# (email/password is unaffected). On Railway BETTER_AUTH_URL must be the real public URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification codes + password reset (mailer.ts, emailGate.ts). Leave EMAIL_GATE unset to keep today's behaviour
# (no codes, no gate, welcome bonus at sign-up); set it to 1 only once RESEND_API_KEY and MAIL_FROM work. With no key on a
# LOCAL database the code is printed in the console instead.
EMAIL_GATE=
RESEND_API_KEY=
MAIL_FROM=
# Local development only: an email domain that skips every email rule and gets dev chips/gems (see emailPolicy.ts
# isTestEmail). Put the value in your own server/.env; it is ignored on any non-local database. Do not document it.
TEST_EMAIL_DOMAIN=
