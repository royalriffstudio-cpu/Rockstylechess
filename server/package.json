{
  "name": "rockstyle-chess-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:remote": "ENV_FILE=.env.production node node_modules/drizzle-kit/bin.cjs migrate",
    "seed:spin": "node node_modules/tsx/dist/cli.mjs src/db/seedSpinPrizes.ts",
    "seed:spin:remote": "ENV_FILE=.env.production node node_modules/tsx/dist/cli.mjs src/db/seedSpinPrizes.ts",
    "seed:cosmetics": "node node_modules/tsx/dist/cli.mjs src/db/seedCosmetics.ts",
    "seed:cosmetics:remote": "ENV_FILE=.env.production node node_modules/tsx/dist/cli.mjs src/db/seedCosmetics.ts",
    "seed:quests": "node node_modules/tsx/dist/cli.mjs src/db/seedQuests.ts",
    "seed:quests:remote": "ENV_FILE=.env.production node node_modules/tsx/dist/cli.mjs src/db/seedQuests.ts",
    "seed:achievements": "node node_modules/tsx/dist/cli.mjs src/db/seedAchievements.ts",
    "seed:achievements:remote": "ENV_FILE=.env.production node node_modules/tsx/dist/cli.mjs src/db/seedAchievements.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.29",
    "better-auth": "^1.6.29",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
